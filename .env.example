# Public identity — MUST be the production URL in production, otherwise
# sitemap.xml, canonical URLs and OG images all emit localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLUB_LINKEDIN=https://www.linkedin.com/company/eclipse-esgen
NEXT_PUBLIC_CLUB_TIKTOK=https://www.tiktok.com/@eclipse.club4
NEXT_PUBLIC_CLUB_INSTAGRAM=https://www.instagram.com/eclipse.esgen
NEXT_PUBLIC_CLUB_EMAIL=eclipse_club@esgen.edu.dz

# Firebase Admin SDK — server-only
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# EmailJS — server-only
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Cloudinary — server-only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin credentials — server-only. Use long, unique values.
# Generate with: openssl rand -hex 32
ADMIN_PASSWORD=your-strong-admin-password-here
ADMIN_SESSION_SECRET=your-long-random-session-secret-here-min-32-chars
